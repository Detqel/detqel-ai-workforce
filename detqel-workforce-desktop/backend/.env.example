PORT=8100
# Required connection security and runtime policy (supply values explicitly).
# Generate each key separately with a cryptographically secure 32-byte base64 value.
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_REQUEST_TIMEOUT_MS=
# JSON arrays of absolute executable paths and permitted filesystem roots.
CONNECTOR_ALLOWED_COMMANDS=
CONNECTOR_ALLOWED_ROOTS=
HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/detqel_workforce
CORS_ORIGIN=http://127.0.0.1:3100,http://localhost:3100
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
# Optional provisioning connection with CREATEDB privileges; used only by db:init/db:setup.
# DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# Optional integration-test admin connection. Tests create and drop uniquely named temporary databases.
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# AI Provider Model Endpoint URLs
OPENAI_MODELS_URL=https://api.openai.com/v1/models
GROQ_MODELS_URL=https://api.groq.com/openai/v1/models
DEEPSEEK_MODELS_URL=https://api.deepseek.com/models
ANTHROPIC_MODELS_URL=https://api.anthropic.com/v1/models
GOOGLE_MODELS_URL=https://generativelanguage.googleapis.com/v1beta/models

# AI Provider Chat/Execution Endpoint URLs
OPENAI_CHAT_URL=https://api.openai.com/v1/chat/completions
GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
DEEPSEEK_CHAT_URL=https://api.deepseek.com/chat/completions
ANTHROPIC_MESSAGES_URL=https://api.anthropic.com/v1/messages
GOOGLE_GENERATE_URL=https://generativelanguage.googleapis.com/v1beta/models
