{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DETQEL Kin",
  "version": "1.0.0",
  "identifier": "com.detqel.workforce",
  "build": {
    "beforeDevCommand": { "script": "npm run prepare:dev", "wait": true },
    "beforeBuildCommand": "npm run build:app",
    "devUrl": "http://127.0.0.1:3100",
    "frontendDist": "../frontend/out",
    "additionalWatchFolders": ["../backend/src"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "DETQEL Kin", "create": false, "visible": false, "width": 1440, "height": 960, "minWidth": 1024, "minHeight": 720 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.unsplash.com; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.unsplash.com; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:3100 ws://127.0.0.1:3100; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["main", "startup"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0OUVGQzU5OUVCMkI2QzEKUldUQnRyS2VXZnllNUpyMkFndmFJM3I1U3laeGFHYmF6ckRoL0psZlJnZlNkZWJyNmpjUmx4T0cK",
      "requireSignedVersion": true,
      "dangerousInsecureTransportProtocol": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "category": "Business",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "DETQEL Kin",
    "externalBin": ["binaries/detqel-node"],
    "resources": { "resources/backend/": "backend/" },
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } }
  }
}
